# Copiar para arquivo privado (0600), fora do Git. Nunca colar segredos no chat.
DEBUG=False
ALLOWED_HOSTS=financeiro.example.invalid
PUBLIC_APP_URL=https://financeiro.example.invalid
# Gere uma nova chave forte. Preserve a anterior nos fallbacks enquanto houver
# senhas fiscais cifradas com ela. Não remova o fallback antes de recifrar/testar.
SECRET_KEY=SUBSTITUIR_POR_CHAVE_ALEATORIA_COM_PELO_MENOS_50_CARACTERES
SECRET_KEY_FALLBACKS=
DATABASE_URL=postgresql://usuario_restrito:SENHA@127.0.0.1:5432/BANCO
DATABASE_USE_ADMIN=False
# Preservar a chave contratada com integrações até a troca coordenada.
API_SECRET_KEY=CHAVE_ATUAL_DOS_CONSUMIDORES
API_INTEGRATION_USER_ID=11
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# True somente com o proxy descrito em nginx.conf.example; acesso direto bloqueado.
TRUST_PROXY_HTTPS=True
# Opcional em servidor único; Redis obrigatório se houver vários servidores.
CACHE_URL=
